root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{rs,ps1,toml}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Keep generator-owned whitespace intact when inspecting the IPC contract.
[src/bindings.ts]
indent_style = tab
trim_trailing_whitespace = false
