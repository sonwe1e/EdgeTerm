{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "src/**",
      "scripts/**",
      "*.ts",
      "*.mjs",
      "biome.json",
      "package.json",
      "tsconfig*.json",
      ".vscode/*.json",
      "!!.tmp",
      "!!artifacts",
      "!!src-tauri/target"
    ],
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100,
    "includes": ["**", "!src/bindings.ts"]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "useExhaustiveDependencies": {
          "level": "error",
          "options": {
            "reportUnnecessaryDependencies": false,
            "hooks": [
              {
                "name": "useStableCallback",
                "stableResult": true
              }
            ]
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "warn"
      },
      "preset": "none"
    }
  }
}
