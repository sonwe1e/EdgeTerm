{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "src/**",
      "scripts/**",
      "*.ts",
      "*.mjs",
      "!!.tmp",
      "!!artifacts",
      "!!src-tauri/target"
    ],
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "useExhaustiveDependencies": {
          "level": "error",
          "options": {
            "reportUnnecessaryDependencies": false,
            "hooks": [
              {
                "name": "useStableCallback",
                "stableResult": true
              }
            ]
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "warn"
      },
      "preset": "none"
    }
  }
}
