# Keep repository content normalized to LF, regardless of the contributor's
# core.autocrlf. Without this, a Windows checkout with core.autocrlf=true
# reports every touched file as modified on the next Git operation, which
# buries the real change under line-ending noise.
* text=auto eol=lf

# Images must never be text-normalized or diffed.
*.png binary
*.webp binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary

# Lock files are regenerated by the tool, not edited by hand.
package-lock.json text eol=lf
Cargo.lock text eol=lf
